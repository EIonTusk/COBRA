{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "COBRA",
	"version": "0.22.2",
	"identifier": "io.github.eiontusk.cobra",
	"build": {
		"beforeDevCommand": "npm run dev",
		"beforeBuildCommand": "npm run build",
		"devUrl": "http://localhost:5173",
		"frontendDist": "../build"
	},
	"app": {
		"windows": [
			{
				"title": "COBRA",
				"width": 1280,
				"height": 820,
				"minWidth": 960,
				"minHeight": 640,
				"resizable": true,
				"fullscreen": false,
				"useHttpsScheme": true
			}
		],
		"security": {
			"csp": null,
			"headers": {
				"Cross-Origin-Opener-Policy": "same-origin",
				"Cross-Origin-Embedder-Policy": "credentialless",
				"Cross-Origin-Resource-Policy": "cross-origin"
			}
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"category": "Game",
		"shortDescription": "Chess opening builder and repertoire analyzer.",
		"longDescription": "COBRA lets you build, drill, and analyze chess opening repertoires with offline Stockfish support.",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"linux": {
			"deb": { "depends": [] }
		}
	},
	"plugins": {
		"deep-link": {
			"mobile": [{ "scheme": ["io.github.eiontusk.cobra"], "appLink": false }],
			"desktop": { "schemes": ["io.github.eiontusk.cobra"] }
		}
	}
}
