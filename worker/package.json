{
  "name": "cobra-sync-worker",
  "version": "0.0.0",
  "private": true,
  "description": "COBRA sync backend — Cloudflare Worker + D1 (issue #68).",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "schema": "wrangler d1 execute cobra-sync --file=./schema.sql",
    "schema:local": "wrangler d1 execute cobra-sync --local --file=./schema.sql",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240000.0",
    "typescript": "^5.6.0",
    "wrangler": "^3.80.0"
  }
}
